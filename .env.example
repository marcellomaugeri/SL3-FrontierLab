# Settings for one deployment of SL3-FrontierLab.
# Copy this file to .env, fill in each empty value, and load it before running Terraform:
#   set -a; . ./.env; set +a

# Proxmox settings
# The server's public IP address, for SSH and the tunnel.
TF_VAR_proxmox_ip=""
# The node name Proxmox shows for the server, for example proxmox-server.
TF_VAR_node_name=""
# The API token for Terraform, written as user@realm!token-name=secret, in single quotes.
PROXMOX_VE_API_TOKEN=''
# The user on the server that the provider signs in as over SSH, through your SSH agent.
PROXMOX_VE_SSH_USERNAME=""
PROXMOX_VE_SSH_AGENT="true"
# Proxmox's API, reached through the SSH tunnel, where SSH identifies the server by its host key.
PROXMOX_VE_ENDPOINT="https://127.0.0.1:8006/"
PROXMOX_VE_INSECURE="true"

# Lab settings
# The components to deploy, by folder name.
TF_VAR_assets='["weight-storage"]'
# The public key that opens the lab's machines.
TF_VAR_ssh_public_key=""
# The lab network; change it when the server's own networks already use this range.
# TF_VAR_lab_subnet="172.16.0.0/24"
