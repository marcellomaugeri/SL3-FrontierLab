# Settings for the dev folder of SL3-FrontierLab.
# Copy this file to .env, fill in each empty value, and load it before running Terraform:
#   set -a; . ./.env; set +a

# The cluster to use, as kubectl names it; kind names it kind-<cluster name>.
TF_VAR_kube_context="kind-sl3-frontierlab"
# The processor of the computer that runs the cluster: amd64 for Intel and AMD processors, arm64 for Apple and other Arm processors.
TF_VAR_architecture=""
# The components to deploy, by folder name.
TF_VAR_assets='["weight-storage"]'
# The public key that opens the machines.
TF_VAR_ssh_public_key=""
