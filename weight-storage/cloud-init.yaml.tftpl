#cloud-config
hostname: ${hostname}

users:
  - default
  - name: seaweedfs
    system: true
    shell: /usr/sbin/nologin

ssh_authorized_keys:
  - ${ssh_public_key}

# Proxmox names the dedicated data disk after its slot, scsi1; a partition table and overwrite: false keep its data when Cloud-Init runs again.
device_aliases:
  weights: /dev/disk/by-id/scsi-0QEMU_QEMU_HARDDISK_drive-scsi1
disk_setup:
  weights:
    table_type: gpt
    layout: true
    overwrite: false
fs_setup:
  - label: weights
    filesystem: ext4
    device: weights.1
    overwrite: false
mounts:
  - ["LABEL=weights", "/srv/seaweedfs", "ext4", "defaults,nofail", "0", "2"]

write_files:
  - path: /etc/systemd/system/seaweedfs.service
    content: |
      [Unit]
      Description=SeaweedFS storage for model weights
      Wants=network-online.target
      After=network-online.target
      RequiresMountsFor=/srv/seaweedfs
      AssertPathIsMountPoint=/srv/seaweedfs

      [Service]
      User=seaweedfs
      Group=seaweedfs
      ExecStart=/usr/local/bin/weed server -dir=/srv/seaweedfs -ip=127.0.0.1 -s3 -volume.max=0 -master.volumeSizeLimitMB=1024
      Restart=on-failure

      [Install]
      WantedBy=multi-user.target

# SeaweedFS 4.53, checked against the SHA-256 that GitHub records for its release file.
runcmd:
  - curl -fsSL -o /tmp/seaweedfs.tar.gz https://github.com/seaweedfs/seaweedfs/releases/download/4.53/linux_amd64.tar.gz && echo "d1a7dec9f48d8b33895a0ea8951971defc2dc5312906dcc76fa5a5f74a6ee90d  /tmp/seaweedfs.tar.gz" | sha256sum --check && tar -xzf /tmp/seaweedfs.tar.gz -C /usr/local/bin weed && chown seaweedfs:seaweedfs /srv/seaweedfs && systemctl daemon-reload && systemctl enable --now seaweedfs.service
